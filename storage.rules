
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado en todo el bucket
    // para asegurar la funcionalidad mientras se depuran problemas de permisos específicos.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

// REGLAS DE SEGURIDAD PARA STORAGE - TRIGGER DEPLOYMENT: 2024-05-20
// Permite acceso completo a usuarios autenticados para asegurar el funcionamiento de los adjuntos.

service firebase.storage {
  match /b/{bucket}/o {
    // Reglas explícitas para carpetas de negocio
    match /opportunities/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /contracts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Regla general para cualquier otra ruta
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

// REGLAS DE SEGURIDAD PARA STORAGE - FORZAR REDESPLIEGUE: 2024-05-21_15-15
// Permite acceso completo de lectura y escritura a cualquier usuario autenticado en todo el bucket.
// Se añaden reglas explícitas para carpetas críticas para asegurar la correcta propagación de permisos.

service firebase.storage {
  match /b/{bucket}/o {
    // Regla explícita para la carpeta de oportunidades
    match /opportunities/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regla explícita para la carpeta de contratos
    match /contracts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Regla global de respaldo para usuarios autenticados
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado.
    // Esto asegura que la App pueda subir archivos a cualquier carpeta (contracts, opportunities, etc.)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

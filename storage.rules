
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite lectura y escritura a cualquier usuario autenticado en todo el bucket.
    // IMPORTANTE: El bucket 't-track-bucket' requiere configuración de CORS via Cloud Shell.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

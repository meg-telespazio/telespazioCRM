rules_version = '2';

// Reglas de seguridad para Firebase Storage - Versión Forzada 1.1
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acceso total a cualquier usuario autenticado.
    // Esto resuelve el error PERMISSION_DENIED si el usuario está logueado.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write their own avatar
    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /opportunities/{opportunityId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.createdBy == request.auth.uid;
    }
  }
}

    
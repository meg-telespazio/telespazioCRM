rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado en todo el bucket.
    // Esto asegura que las carpetas /contracts y /opportunities sean accesibles.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

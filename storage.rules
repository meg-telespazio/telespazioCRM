
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir a usuarios leer y escribir sus avatares
    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Carpeta de Oportunidades: organizada por ID de oportunidad
    match /opportunities/{opportunityId}/{allPaths=**} {
       allow read, write: if request.auth != null;
    }

    // Carpeta de Contratos: organizada por ID de contrato
    match /contracts/{contractId}/{allPaths=**} {
       allow read, write: if request.auth != null;
    }
  }
}

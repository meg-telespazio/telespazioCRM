rules_version = '2';

// Reglas de seguridad para Firebase Storage - Versión Forzada 1.2 (Redespliegue)
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acceso a cualquier usuario autenticado en todo el bucket
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

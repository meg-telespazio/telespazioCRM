[
  {
    "origin": ["https://*.cloudworkstations.dev", "http://localhost:9002"],
    "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "x-goog-resumable",
      "Content-Length",
      "Accept-Encoding",
      "X-Upload-Content-Type",
      "X-Upload-Content-Length",
      "X-Goog-Upload-Protocol",
      "X-Goog-Upload-Command",
      "X-Goog-Upload-Offset"
    ],
    "maxAgeSeconds": 3600
  }
]

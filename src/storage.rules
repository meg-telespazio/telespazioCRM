rules_version = '2';

// Reglas de seguridad para Firebase Storage (Source)
// Fecha de actualización: 2024-05-22 (Force Redeploy)
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado en todo el bucket.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

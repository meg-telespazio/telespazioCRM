rules_version = '2';

// REGLAS DE SEGURIDAD PARA STORAGE (Sync) - ACTUALIZACIÓN PARA OPORTUNIDADES
// Permite acceso de lectura y escritura a usuarios autenticados en carpetas críticas.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Regla para Contratos
    match /contracts/{contractId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Regla para Oportunidades (Soluciona el error de permisos)
    match /opportunities/{opportunityId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regla global de respaldo para usuarios autenticados
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
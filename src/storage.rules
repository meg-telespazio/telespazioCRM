rules_version = '2';

// REGLAS DE SEGURIDAD PARA STORAGE (Sync) - FORZAR DESPLIEGUE: 2024-05-21_14-30
// Permite acceso completo de lectura y escritura a cualquier usuario autenticado.
// Esto soluciona los errores de 'storage/unauthorized' en adjuntos de oportunidades y contratos.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
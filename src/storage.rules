
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado en todo el bucket
    // IMPORTANTE: Para buckets de Google Cloud externos como 't-track-bucket', 
    // es mandatorio configurar las políticas CORS mediante gsutil.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

// REGLAS DE SEGURIDAD PARA STORAGE (Sync)
// Permite acceso completo a usuarios autenticados para asegurar el funcionamiento de los adjuntos.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

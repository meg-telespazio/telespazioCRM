rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura a cualquier usuario autenticado en todo el bucket.
    // Esto es necesario para que los comerciales puedan subir documentación de contratos y ofertas.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

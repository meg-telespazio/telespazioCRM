
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers de Autenticación y Perfil ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // El Super Admin tiene bypass total. Solo Mariano Gonzalez.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'mariano.gonzalez@telespazio.com';
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function getPermissions() {
      let path = /databases/$(database)/documents/systemConfig/globals;
      let role = getUserData().role;
      return exists(path) ? get(path).data.permissionsMatrix[role] : null;
    }

    // El Admin tiene permisos de gestión sobre cualquier gerencia, pero sujeto a auditoría.
    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && getUserData().role == 'admin');
    }

    // --- Helpers Dinámicos basados en la Matriz ---

    function hasPermission(module, action) {
      return isAdmin() || (isAuthenticated() && getPermissions().modules[module][action] == true);
    }

    // Comprueba si el documento pertenece a la gerencia del usuario
    function isSameManagement(data) {
      return isAdmin() || data.management == getUserData().get('management', '');
    }

    // Comprueba si el usuario es the responsable asignado
    function isAssignedTo(data) {
      return data.assignedTo == request.auth.uid;
    }

    // --- Reglas por Colección ---

    match /users/{userId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      
      match /reports/{reportId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // Solicitudes de acceso: cualquiera puede crear, solo admin leer
    match /accessRequests/{requestId} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Auditoría: Solo admins pueden leer los logs. Nadie puede borrarlos.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; 
      allow update, delete: if false; 
    }

    match /clients/{clientId} {
      allow read: if hasPermission('clients', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('clients', 'create');
      allow update: if hasPermission('clients', 'edit') && isSameManagement(resource.data) && (isAdmin() || getUserData().role == 'gerente' || isAssignedTo(resource.data));
      allow delete: if hasPermission('clients', 'delete') && isSameManagement(resource.data); 
    }

    match /contacts/{contactId} {
      allow read: if hasPermission('contacts', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('contacts', 'create');
      allow update: if hasPermission('contacts', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('contacts', 'delete') && isSameManagement(resource.data);
    }

    match /locations/{locationId} {
      allow read: if hasPermission('locations', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('locations', 'create');
      allow update: if hasPermission('locations', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('locations', 'delete') && isSameManagement(resource.data);
    }

    match /opportunities/{opportunityId} {
      allow read: if hasPermission('opportunities', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('opportunities', 'create');
      allow update: if hasPermission('opportunities', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('opportunities', 'delete') && isSameManagement(resource.data);
    }

    match /purchaseOrders/{poId} {
      allow read: if hasPermission('purchaseOrders', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('purchaseOrders', 'create');
      allow update: if hasPermission('purchaseOrders', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('purchaseOrders', 'delete') && isSameManagement(resource.data);
    }

    match /services/{serviceId} {
      allow read: if hasPermission('services', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('services', 'create');
      allow update: if hasPermission('services', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('services', 'delete') && isSameManagement(resource.data);
    }

    match /contracts/{contractId} {
      allow read: if hasPermission('contracts', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('contracts', 'create');
      allow update: if hasPermission('contracts', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('contracts', 'delete') && isSameManagement(resource.data);
      
      match /addendums/{addendumId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/contracts/$(contractId)).data);
        allow write: if hasPermission('contracts', 'edit') && isSameManagement(get(/databases/$(database)/documents/contracts/$(contractId)).data);
      }
    }

    match /equipment/{equipmentId} {
      allow read: if hasPermission('equipment', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('equipment', 'create');
      allow update: if hasPermission('equipment', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('equipment', 'delete') && isSameManagement(resource.data);
    }

    match /activities/{activityId} {
      allow read: if hasPermission('activities', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('activities', 'create');
      allow update: if hasPermission('activities', 'edit') && isSameManagement(resource.data);
      allow delete: if hasPermission('activities', 'delete') && isSameManagement(resource.data);

      match /followUps/{followUpId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/activities/$(activityId)).data);
        allow write: if hasPermission('activities', 'edit') && isSameManagement(get(/databases/$(database)/documents/activities/$(activityId)).data);
      }
    }

    match /productsAndServices/{itemId} {
      allow read: if hasPermission('productsAndServices', 'view');
      allow write: if isAdmin() || (getUserData().role == 'gerente' && hasPermission('productsAndServices', 'create'));
    }

    match /holdings/{holdingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || getUserData().role == 'gerente';
    }

    match /counters/{counterId} {
      allow get, update, create: if isAuthenticated();
      allow list, delete: if isSuperAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exchangeRateHistory/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}

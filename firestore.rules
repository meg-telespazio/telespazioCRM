rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers de Autenticación y Perfil ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // El Super Admin tiene bypass total. Solo Mariano Gonzalez.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'mariano.gonzalez@telespazio.com';
    }

    // El Admin tiene permisos de gestión sobre cualquier gerencia, pero sujeto a auditoría.
    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin');
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    // --- Helpers de Permisos por Rol ---

    function isGerente() {
      return getUserData().get('role', 'ejecutivo') == 'gerente';
    }

    function isEjecutivo() {
      return getUserData().get('role', 'ejecutivo') == 'ejecutivo';
    }

    function isIngeniero() {
      return getUserData().get('role', 'ejecutivo') == 'ingeniero';
    }

    // Comprueba si el documento pertenece a la gerencia del usuario
    function isSameManagement(data) {
      return data.management == getUserData().get('management', '');
    }

    // Comprueba si el usuario es the responsable asignado
    function isAssignedTo(data) {
      return data.assignedTo == request.auth.uid;
    }

    // --- Reglas por Colección ---

    match /users/{userId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      
      match /reports/{reportId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    // Solicitudes de acceso: cualquiera puede crear, solo admin leer
    match /accessRequests/{requestId} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Auditoría: Solo admins pueden leer los logs. Nadie puede borrarlos.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Validamos que el log sea creado por el usuario autenticado para evitar spoofing
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; 
      allow update, delete: if false; // Inmutabilidad de los logs
    }

    // Clientes, Contactos, Locaciones: Visibles por todos en la gerencia, editables por Gerente o Ejecutivo asignado
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isAdmin() || isSameManagement(resource.data));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
      allow delete: if isAdmin() || (isSameManagement(resource.data) && isGerente()); // Solo gerentes borran
    }

    match /contacts/{contactId} {
      allow read: if isAuthenticated() && (isAdmin() || isSameManagement(resource.data));
      allow write: if isAdmin() || (isAuthenticated() && isSameManagement(request.resource.data) && (isGerente() || isEjecutivo()));
      allow update, delete: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
    }

    match /locations/{locationId} {
      allow read: if isAuthenticated() && (isAdmin() || isSameManagement(resource.data));
      allow write: if isAdmin() || (isAuthenticated() && isSameManagement(request.resource.data) && (isGerente() || isEjecutivo()));
      allow update, delete: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
    }

    // Oportunidades, POs, Servicios: No visibles para Ingenieros
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated() && (isAdmin() || (isSameManagement(resource.data) && !isIngeniero()));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
      allow delete: if isAdmin() || (isSameManagement(resource.data) && isGerente());
    }

    match /purchaseOrders/{poId} {
      allow read: if isAuthenticated() && (isAdmin() || (isSameManagement(resource.data) && !isIngeniero()));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
      allow delete: if isAdmin() || (isSameManagement(resource.data) && isGerente());
    }

    match /services/{serviceId} {
      allow read: if isAuthenticated() && (isAdmin() || (isSameManagement(resource.data) && !isIngeniero()));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
      allow delete: if isAdmin() || (isSameManagement(resource.data) && isGerente());
    }

    // Contratos: Ingenieros pueden verlos
    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (isAdmin() || isSameManagement(resource.data));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));
      allow delete: if isAdmin() || (isSameManagement(resource.data) && isGerente());
      
      match /addendums/{addendumId} {
        allow read: if isAuthenticated() && (isAdmin() || isSameManagement(get(/databases/$(database)/documents/contracts/$(contractId)).data));
        allow write: if isAdmin() || (isGerente() && isSameManagement(get(/databases/$(database)/documents/contracts/$(contractId)).data));
      }
    }

    // Activos (Kits): Visibles por todos en la gerencia
    match /equipment/{equipmentId} {
      allow read: if isAuthenticated() && (isAdmin() || isSameManagement(resource.data));
      allow write: if isAdmin() || isGerente();
    }

    // Actividades: No visibles para ingenieros
    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isAdmin() || (isSameManagement(resource.data) && !isIngeniero()));
      allow create: if isAuthenticated() && (isAdmin() || isGerente() || isEjecutivo());
      allow update, delete: if isAdmin() || (isSameManagement(resource.data) && (isGerente() || isAssignedTo(resource.data)));

      match /followUps/{followUpId} {
        allow read: if isAuthenticated() && (isAdmin() || isSameManagement(get(/databases/$(database)/documents/activities/$(activityId)).data));
        allow write: if isAuthenticated() && (isAdmin() || isSameManagement(get(/databases/$(database)/documents/activities/$(activityId)).data));
      }
    }

    match /productsAndServices/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /holdings/{holdingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isGerente();
    }

    // Contadores: Protegidos contra borrado masivo.
    match /counters/{counterId} {
      allow get, update, create: if isAuthenticated();
      allow list, delete: if isSuperAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exchangeRateHistory/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}

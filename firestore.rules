rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers de Autenticación y Perfil ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // El Super Admin tiene bypass total.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'mariano.gonzalez@telespazio.com';
    }

    // Función optimizada para obtener los datos del usuario logueado
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    // Función optimizada para obtener permisos desde la matriz global
    function getRolePermissions() {
      let path = /databases/$(database)/documents/systemConfig/globals;
      let userData = getUserData();
      let role = userData.get('role', 'ejecutivo');
      return exists(path) ? get(path).data.permissionsMatrix[role] : null;
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && getUserData().get('role', '') == 'admin');
    }

    // Validación de permisos dinámicos contra la matriz en systemConfig
    function hasPermission(module, action) {
      let perms = getRolePermissions();
      return isAdmin() || (
        isAuthenticated() && 
        perms != null && 
        perms.modules.keys().contains(module) &&
        perms.modules[module].get(action, false) == true
      );
    }

    // Aislamiento de datos por gerencia
    function isSameManagement(data) {
      let userMgt = getUserData().get('management', 'Satellite Communications');
      let docMgt = data.get('management', 'Satellite Communications');
      return isAdmin() || (userMgt != '' && docMgt == userMgt);
    }

    function isOwner(data) {
      return data.get('assignedTo', '') == request.auth.uid || data.get('createdBy', '') == request.auth.uid;
    }

    function canModify(data) {
      return isAdmin() || (isSameManagement(data) && (getUserData().get('role', '') == 'gerente' || isOwner(data)));
    }

    // --- Reglas por Colección ---

    match /users/{userId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      
      match /reports/{reportId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    match /service_orders/{soId} {
      allow read: if hasPermission('serviceOrders', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('serviceOrders', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('serviceOrders', 'edit') && (isAdmin() || getUserData().get('role', '') == 'gerente' || 
        (request.auth.uid == resource.data.eeccId || request.auth.uid == resource.data.pmAssignedId));
      allow delete: if hasPermission('serviceOrders', 'delete') && isAdmin();

      match /items/{itemId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/service_orders/$(soId)).data);
        allow write: if isAdmin() || getUserData().get('role', '') == 'gerente' || 
          (request.auth.uid == get(/databases/$(database)/documents/service_orders/$(soId)).data.eeccId || 
           request.auth.uid == get(/databases/$(database)/documents/service_orders/$(soId)).data.pmAssignedId);
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/service_orders/$(soId)).data);
        allow create: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/service_orders/$(soId)).data);
      }
    }

    // Notificaciones y Correo
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; 
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.toEmail == request.auth.token.email;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.toEmail == request.auth.token.email;
      allow delete: if isAdmin();
    }

    match /accessRequests/{requestId} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid; 
      allow update, delete: if false; 
    }

    match /clients/{clientId} {
      allow read: if hasPermission('clients', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('clients', 'create') && (isAdmin() || (request.resource.data.get('management', '') != '' && request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications')));
      allow update: if hasPermission('clients', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('clients', 'delete') && canModify(resource.data); 
    }

    match /contacts/{contactId} {
      allow read: if hasPermission('contacts', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('contacts', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('contacts', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('contacts', 'delete') && canModify(resource.data);
    }

    match /locations/{locationId} {
      allow read: if hasPermission('locations', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('locations', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('locations', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('locations', 'delete') && canModify(resource.data);
    }

    match /opportunities/{opportunityId} {
      allow read: if hasPermission('opportunities', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('opportunities', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('opportunities', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('opportunities', 'delete') && canModify(resource.data);
    }

    match /purchaseOrders/{poId} {
      allow read: if hasPermission('purchaseOrders', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('purchaseOrders', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('purchaseOrders', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('purchaseOrders', 'delete') && canModify(resource.data);
    }

    match /services/{serviceId} {
      allow read: if hasPermission('services', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('services', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('services', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('services', 'delete') && canModify(resource.data);
    }

    match /contracts/{contractId} {
      allow read: if hasPermission('contracts', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('contracts', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('contracts', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('contracts', 'delete') && canModify(resource.data);
      
      match /addendums/{addendumId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/contracts/$(contractId)).data);
        allow write: if hasPermission('contracts', 'edit') && canModify(get(/databases/$(database)/documents/contracts/$(contractId)).data);
      }
    }

    match /equipment/{equipmentId} {
      allow read: if hasPermission('equipment', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('equipment', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('equipment', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('equipment', 'delete') && canModify(resource.data);
    }

    match /activities/{activityId} {
      allow read: if hasPermission('activities', 'view') && isSameManagement(resource.data);
      allow create: if hasPermission('activities', 'create') && (isAdmin() || request.resource.data.get('management', '') == getUserData().get('management', 'Satellite Communications'));
      allow update: if hasPermission('activities', 'edit') && canModify(resource.data);
      allow delete: if hasPermission('activities', 'delete') && canModify(resource.data);

      match /followUps/{followUpId} {
        allow read: if isAuthenticated() && isSameManagement(get(/databases/$(database)/documents/activities/$(activityId)).data);
        allow write: if hasPermission('activities', 'edit') && canModify(get(/databases/$(database)/documents/activities/$(activityId)).data);
      }
    }

    match /productsAndServices/{itemId} {
      allow read: if hasPermission('productsAndServices', 'view');
      allow write: if isAdmin() || (getUserData().get('role', '') == 'gerente' && hasPermission('productsAndServices', 'create'));
    }

    match /holdings/{holdingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || getUserData().get('role', '') == 'gerente';
    }

    match /counters/{counterId} {
      allow get, update, create: if isAuthenticated();
      allow list, delete: if isSuperAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exchangeRateHistory/{historyId} {
      allow read, write: if isAdmin();
    }
    
    // --- Public Quote Requests ---
    match /quoteRequests/{requestId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
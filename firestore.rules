
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == 'mariano.gonzalez@telespazio.com' || getUserData().role == 'admin');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function canReadData(data) {
      let user = getUserData();
      return isAdmin() || 
             data.assignedTo == request.auth.uid || 
             (user.role == 'gerente' && data.management == user.management) ||
             (user.role == 'ingeniero' && data.management == user.management);
    }

    match /users/{userId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /clients/{clientId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow create: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.assignedTo == request.auth.uid);
    }

    match /holdings/{holdingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente');
    }

    match /contacts/{contactId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
    }

    match /opportunities/{opportunityId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
    }

    match /contracts/{contractId} {
      allow read: if request.auth != null && getUserData().role != 'ingeniero' && canReadData(resource.data);
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
      
      match /addendums/{addendumId} {
        allow read, write: if request.auth != null && getUserData().role != 'ingeniero';
      }
    }

    match /purchaseOrders/{poId} {
      allow read: if request.auth != null && getUserData().role != 'ingeniero' && canReadData(resource.data);
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
    }

    match /services/{serviceId} {
      allow read: if request.auth != null && getUserData().role != 'ingeniero' && canReadData(resource.data);
      allow write: if request.auth != null && (isAdmin() || getUserData().role == 'gerente' || getUserData().role == 'ejecutivo');
    }

    match /equipment/{equipmentId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow write: if isAdmin();
    }

    match /productsAndServices/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow write: if request.auth != null;

      match /followUps/{followUpId} {
        allow read: if request.auth != null && canReadData(get(/databases/$(database)/documents/activities/$(activityId)).data);
        allow write: if request.auth != null;
      }
    }

    match /locations/{locationId} {
      allow read: if request.auth != null && canReadData(resource.data);
      allow write: if request.auth != null;
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    match /systemConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /exchangeRateHistory/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}

{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID from Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "displayName": {
          "type": "string",
          "description": "The user's full display name."
        },
        "photoURL": {
          "type": "string",
          "description": "Data URL of the user's profile picture."
        },
        "phone": {
          "type": "string",
          "description": "The user's primary phone number."
        },
        "mobile": {
          "type": "string",
          "description": "The user's mobile phone number."
        },
        "notes": {
          "type": "string",
          "description": "General notes about the user."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "The user's account status."
        },
        "position": {
          "type": "string",
          "enum": ["Director", "Manager", "Executive", "Project Manager"],
          "description": "The user's job position."
        },
        "tablePreferences": {
          "type": "object",
          "description": "Stores user's column visibility preferences for various tables."
        }
      },
      "required": [
        "uid",
        "email",
        "firstName",
        "lastName",
        "displayName",
        "phone",
        "status",
        "position"
      ]
    },
    "Client": {
      "title": "Client",
      "description": "Represents a business client.",
      "type": "object",
      "properties": {
        "publicId": {
          "type": "string",
          "description": "Public-facing sequential client ID."
        },
        "name": {
          "type": "string",
          "description": "Name of the client company."
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Client's official website."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email for the client."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number for the client."
        },
        "cuit": {
          "type": "string",
          "description": "Client's CUIT number (11 digits)."
        },
        "holding": {
          "type": "string",
          "description": "The economic group or holding company the client belongs to."
        },
        "linkedinPage": {
          "type": "string",
          "format": "uri",
          "description": "Client's LinkedIn page URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the client was created."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the user who created the client."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "canceled"]
        },
        "industry": {
          "type": "string",
          "description": "The industry the client belongs to."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about the client."
        },
        "logoURL": {
          "type": "string",
          "description": "Data URL of the client's logo."
        }
      },
      "required": [
        "publicId",
        "name",
        "email",
        "phone",
        "cuit",
        "createdAt",
        "createdBy",
        "status",
        "industry"
      ]
    },
    "Contact": {
      "title": "Contact",
      "description": "Represents a contact person at a client company.",
      "type": "object",
      "properties": {
        "publicId": {
          "type": "string",
          "description": "Public-facing sequential contact ID (CT-0000001)."
        },
        "name": {
          "type": "string",
          "description": "Full name of the contact person."
        },
        "position": {
          "type": "string",
          "description": "The contact's job position.",
          "enum": [
            "Analyst",
            "CEO",
            "CFO",
            "CIO",
            "CISO",
            "Head",
            "Manager"
          ]
        },
        "area": {
          "type": "string",
          "description": "The contact's area or department.",
          "enum": [
            "Administration",
            "IT",
            "Legal",
            "Marketing",
            "Procurement",
            "Sales",
            "Supplier Payments"
          ]
        },
        "emails": {
          "type": "array",
          "description": "A list of email addresses for the contact.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["work", "personal", "other"],
                "description": "The type of email address."
              },
              "address": {
                "type": "string",
                "format": "email",
                "description": "The email address."
              }
            },
            "required": ["type", "address"]
          }
        },
        "phones": {
          "type": "array",
          "description": "A list of phone numbers for the contact.",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["mobile", "landline", "work", "home"],
                "description": "The type of phone number."
              },
              "number": {
                "type": "string",
                "description": "The phone number."
              }
            },
            "required": ["type", "number"]
          }
        },
        "notes": {
          "type": "string",
          "description": "General notes about the contact."
        },
        "clientId": {
          "type": "string",
          "description": "ID of the client this contact is associated with."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the contact was created."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the user who created the contact."
        }
      },
      "required": [
        "publicId",
        "name",
        "clientId",
        "createdAt",
        "createdBy"
      ]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Represents a sales opportunity.",
      "type": "object",
      "properties": {
        "publicId": {
          "type": "string",
          "description": "Public-facing yearly sequential opportunity ID (OP-YYYY-000001)."
        },
        "title": {
          "type": "string",
          "description": "Title of the opportunity."
        },
        "clientId": {
          "type": "string",
          "description": "ID of the associated client."
        },
        "value": {
          "type": "number",
          "description": "Estimated value of the opportunity."
        },
        "stage": {
          "type": "string",
          "enum": [
            "Prospecting",
            "Proposal",
            "Negotiation",
            "Won",
            "Lost",
            "Canceled",
            "Suspended"
          ]
        },
        "probability": {
          "type": "number",
          "description": "Probability of winning the opportunity (0-100)."
        },
        "closeDate": {
          "type": "string",
          "format": "date-time",
          "description": "Estimated close date for the opportunity."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the opportunity was created."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the user who created the opportunity."
        },
        "contractMonths": {
          "type": "number",
          "enum": [12, 24, 36],
          "description": "Duration of the contract in months."
        },
        "requestDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date when the opportunity was requested."
        },
        "offerSentDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date when the offer was sent to the client."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the opportunity."
        },
        "reason": {
          "type": "string",
          "description": "Reason for Lost, Canceled, or Suspended status."
        },
        "competition": {
          "type": "array",
          "description": "List of competitors for this opportunity.",
          "items": {
            "type": "string"
          }
        },
        "isTender": {
          "type": "boolean",
          "description": "Indicates if the opportunity is a tender/bid."
        },
        "contactId": {
          "type": "string",
          "description": "ID of the reference contact person from the client."
        },
        "lineItems": {
          "type": "array",
          "description": "List of products or services included in the opportunity.",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "description": "ID of the catalog item from the productsAndServices collection."
              },
              "name": {
                "type": "string",
                "description": "Denormalized name of the item at the time of adding."
              },
              "description": {
                "type": "string",
                "description": "Denormalized or edited description of the item."
              },
              "quantity": {
                "type": "number"
              },
              "oneTimeCharge": {
                "type": "number",
                "description": "The one-time charge per unit for this specific opportunity."
              },
              "recurringCharge": {
                "type": "number",
                "description": "The recurring charge per unit for this specific opportunity."
              },
              "discount": {
                "type": "number",
                "description": "The discount percentage applied."
              }
            },
            "required": ["itemId", "name", "quantity"]
          }
        },
        "generalDiscountPercentage": {
          "type": "number",
          "description": "The general discount percentage to apply to the whole opportunity."
        },
        "applyDiscountToNrc": {
          "type": "boolean",
          "description": "Indicates if the general discount applies to one-time charges."
        },
        "applyDiscountToMrc": {
          "type": "boolean",
          "description": "Indicates if the general discount applies to recurring charges."
        }
      },
      "required": [
        "publicId",
        "title",
        "clientId",
        "value",
        "stage",
        "probability",
        "closeDate",
        "createdAt",
        "createdBy",
        "contractMonths",
        "requestDate",
        "isTender"
      ]
    },
    "ProductOrService": {
      "title": "Product or Service",
      "description": "Represents a product or a service in the catalog.",
      "type": "object",
      "properties": {
        "publicId": {
          "type": "string",
          "description": "Public-facing sequential ID (C-PO-00000001 for product, C-SRV-00000001 for service)."
        },
        "type": {
          "type": "string",
          "enum": ["product", "service", "bundle"],
          "description": "Indicates if the item is a product or a service."
        },
        "name": {
          "type": "string",
          "description": "Name of the product or service."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the item."
        },
        "photoURL": {
          "type": "string",
          "description": "Data URL of the product or service's photo."
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "The status of the item in the catalog."
        },
        "unitOfMeasure": {
          "type": "string",
          "enum": ["units", "meters", "kg", "liters", "GB"],
          "description": "The unit of measure for the item."
        },
        "oneTimeCharge": {
          "type": "number",
          "description": "One-time charge per unit."
        },
        "recurringCharge": {
          "type": "number",
          "description": "Recurring charge (subscription) per unit."
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "ARS"],
          "description": "The currency for the charges."
        },
        "isEditable": {
          "type": "boolean",
          "description": "Indicates if the item's properties can be edited when added to an opportunity."
        },
        "availableDiscounts": {
          "type": "array",
          "description": "Array of available discount percentages.",
          "items": {
            "type": "number"
          }
        },
        "createdBy": {
            "type": "string",
            "description": "UID of the user who created the item."
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of when the item was created."
        },
        "bundleItems": {
          "type": "array",
          "description": "List of items included in the bundle.",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "description": "ID of the catalog item."
              },
              "quantity": {
                "type": "number"
              }
            },
            "required": ["itemId", "quantity"]
          }
        }
      },
      "required": [
        "publicId",
        "type",
        "name",
        "status",
        "createdBy",
        "createdAt"
      ]
    },
    "Report": {
      "title": "Report",
      "description": "Represents a saved report configuration.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the report."
        },
        "description": {
          "type": "string",
          "description": "A description of the report."
        },
        "primaryDataSource": {
          "type": "string",
          "enum": [
            "clients",
            "contacts",
            "opportunities",
            "productsAndServices"
          ]
        },
        "selectedFields": {
          "type": "array",
          "description": "List of field keys to include in the report.",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "description": "Saved filter configuration for the report.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "operator": { "type": "string" },
              "value": { "type": "any" }
            },
             "required": ["id", "field", "operator"]
          }
        },
        "sorting": {
           "type": "array",
           "description": "Saved sorting configuration for the report.",
           "items": {
             "type": "object",
             "properties": {
                "id": { "type": "string" },
                "field": { "type": "string" },
                "direction": { "type": "string", "enum": ["asc", "desc"] }
             },
             "required": ["id", "field", "direction"]
           }
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "primaryDataSource",
        "selectedFields",
        "createdBy",
        "createdAt"
      ]
    },
    "Activity": {
      "title": "Activity",
      "description": "Represents a client-related activity or interaction.",
      "type": "object",
      "properties": {
        "publicId": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["call", "meeting", "email", "message"]
        },
        "description": {
          "type": "string"
        },
        "isPriority": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of when the activity was last updated, including new follow-ups."
        }
      },
      "required": [
        "publicId",
        "clientId",
        "type",
        "description",
        "createdAt",
        "createdBy"
      ]
    },
    "ActivityFollowUp": {
      "title": "Activity Follow-Up",
      "description": "Represents a comment or update on a parent activity.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        }
      },
      "required": ["content", "createdAt", "createdBy"]
    },
    "Location": {
      "title": "Location",
      "description": "Represents a physical location of a client.",
      "type": "object",
      "properties": {
        "publicId": { "type": "string", "description": "Public-facing sequential location ID (LOC-00000001)." },
        "name": { "type": "string", "description": "Name of the location." },
        "clientId": { "type": "string", "description": "ID of the client this location belongs to." },
        "type": { "type": "string", "enum": ["branch", "headquarters", "warehouse", "office", "property", "field"], "description": "Type of the location." },
        "status": { "type": "string", "enum": ["active", "suspended"], "description": "Status of the location." },
        "streetName": { "type": "string", "description": "Street name of the address." },
        "streetNumber": { "type": "string", "description": "Street number of the address." },
        "city": { "type": "string", "description": "City of the address." },
        "province": { "type": "string", "description": "Province or state of the address." },
        "country": { "type": "string", "description": "Country of the address." },
        "postalCode": { "type": "string", "description": "Postal code of the address." },
        "notes": { "type": "string", "description": "Additional notes about the location." },
        "latitude": { "type": "number", "description": "Latitude for geolocation." },
        "longitude": { "type": "number", "description": "Longitude for geolocation." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of when the location was created." },
        "createdBy": { "type": "string", "description": "UID of the user who created the location." }
      },
      "required": ["publicId", "name", "clientId", "type", "status", "streetName", "streetNumber", "city", "province", "country", "postalCode", "latitude", "longitude", "createdAt", "createdBy"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/Report"
      },
      "description": "Stores user-created report configurations."
    },
    "/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Stores information about clients."
    },
    "/contacts/{contactId}": {
      "schema": {
        "$ref": "#/entities/Contact"
      },
      "description": "Stores contact information for clients."
    },
    "/opportunities/{opportunityId}": {
      "schema": {
        "$ref": "#/entities/Opportunity"
      },
      "description": "Stores sales opportunities."
    },
    "/productsAndServices/{itemId}": {
      "schema": {
        "$ref": "#/entities/ProductOrService"
      },
      "description": "Stores catalog products and services."
    },
    "/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/Activity"
      },
      "description": "Stores all client activities."
    },
    "/activities/{activityId}/followUps/{followUpId}": {
      "schema": {
        "$ref": "#/entities/ActivityFollowUp"
      },
      "description": "Stores follow-up comments for a specific activity."
    },
    "/locations/{locationId}": {
      "schema": {
        "$ref": "#/entities/Location"
      },
      "description": "Stores client locations."
    }
  }
}

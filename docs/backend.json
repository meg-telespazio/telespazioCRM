
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "role": { "type": "string", "enum": ["admin", "gerente", "ejecutivo", "ingeniero"] },
        "position": { "type": "string", "enum": ["Director", "Manager", "Executive", "Project Manager"] },
        "management": { "type": "string", "enum": ["Satellite Communications", "GeoInformacion"] },
        "mfaEnforced": { "type": "boolean" }
      },
      "required": ["uid", "email", "firstName", "lastName", "role", "management"]
    },
    "Client": {
      "title": "Client",
      "description": "Represents a business client.",
      "type": "object",
      "properties": {
        "publicId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "taxIdType": { "type": "string", "enum": ["CUIT", "RUT_CL", "RUC_PE", "CNPJ", "RUT_CO", "NIT_CR", "EIN_US", "OTHER"] },
        "cuit": { "type": "string", "description": "The numeric Tax ID value" },
        "holding": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "canceled"] },
        "sector": { "type": "string" },
        "subsector": { "type": "string" },
        "management": { "type": "string", "enum": ["Satellite Communications", "GeoInformacion"] },
        "assignedTo": { "type": "string" },
        "costCenterId": { "type": "string" }
      },
      "required": ["publicId", "name", "taxIdType", "cuit", "status", "sector", "management", "assignedTo"]
    },
    "ServiceOrder": {
      "title": "Service Order",
      "description": "Represents a transition from contract to operations.",
      "type": "object",
      "properties": {
        "publicId": { "type": "string" },
        "contractId": { "type": "string" },
        "clientId": { "type": "string" },
        "eeccId": { "type": "string" },
        "pmAssignedId": { "type": "string" },
        "status": { "type": "string", "enum": ["Abierta", "Asignada", "Devuelta", "Cancelada", "Cerrada"] },
        "type": { "type": "string", "enum": ["Alta", "Modificación", "Baja"] },
        "itemsCount": { "type": "number" },
        "management": { "type": "string", "enum": ["Satellite Communications", "GeoInformacion"] }
      },
      "required": ["publicId", "contractId", "clientId", "status", "type", "management"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "User profiles and settings." },
    "/clients/{clientId}": { "schema": { "$ref": "#/entities/Client" }, "description": "Client accounts." },
    "/service_orders/{soId}": { "schema": { "$ref": "#/entities/ServiceOrder" }, "description": "Operational service orders." }
  }
}
